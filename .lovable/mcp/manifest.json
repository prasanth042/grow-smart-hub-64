{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://anscaiqgywdinugxmqps.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "smart-farmer-assistant-mcp",
      "version": "0.1.0",
      "title": "Smart Farmer Assistant"
    },
    "tools": [
      {
        "name": "list_lands",
        "title": "List my lands",
        "description": "List all land parcels registered by the signed-in farmer, including soil type, water source and area.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_expenses",
        "title": "List farm expenses",
        "description": "List recent farm expenses for the signed-in farmer. Optionally filter by category or a start date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Optional expense category filter (e.g. seeds, fertilizer, labor)."
            },
            "since": {
              "type": "string",
              "description": "Optional ISO date (YYYY-MM-DD); only return expenses on/after this date."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "record_expense",
        "title": "Record a farm expense",
        "description": "Insert a new expense for the signed-in farmer.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Amount in INR."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Category, e.g. seeds, fertilizer, labor, fuel."
            },
            "spent_on": {
              "type": "string",
              "description": "Date the money was spent (YYYY-MM-DD). Defaults to today."
            },
            "note": {
              "type": "string",
              "description": "Optional description."
            },
            "land_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional land parcel ID this expense belongs to."
            }
          },
          "required": [
            "amount",
            "category"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_sales",
        "title": "List crop sales",
        "description": "List recent crop sales for the signed-in farmer, with revenue totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "crop": {
              "type": "string",
              "description": "Optional crop filter (e.g. paddy, tomato)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Max rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
